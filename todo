python scripts/evaluate.py --model models/ppo_v4_vec_normalise --rate 0.5 --episodes 30 --tag seen_load_v4_vec_normalise
python scripts/evaluate.py --model models/ppo_v4_vec_normalise --rate 0.9 --episodes 30 --tag unseen_load_v4_vec_normalise